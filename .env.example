# ──────────────────────────────────────────────
# Content IQ — Environment Variables Template
# Copy this to .env and fill in real values.
# NEVER commit .env to git.
# ──────────────────────────────────────────────

# Azure OpenAI (via AI Foundry)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMB_DEPLOYMENT=text-embedding-ada-002

# Azure AI Search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX_NAME=content-iq-index

# Azure Content Understanding
AZURE_CU_ENDPOINT=
AZURE_CU_KEY=

# Azure Blob Storage (Managed Identity auth — shared key access is disabled)
# Set to the storage account name only, e.g. mycompanydocs
# Auth: DefaultAzureCredential (Managed Identity in Azure, az login locally)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER=documents

# Bing Search v7 (web fallback)
BING_API_KEY=

# Tuning
CONFIDENCE_THRESHOLD=0.6
TOP_K_RESULTS=5
